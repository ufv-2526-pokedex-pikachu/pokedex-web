# Copia este archivo como .env y rellénalo. El .env nunca se sube a Git.
# ID de cliente OAuth de Google (Google Auth Platform → Clientes). Es público.
GOOGLE_CLIENT_ID=123456789-xxxxxxxx.apps.googleusercontent.com
# Secreto propio del puente para calcular las contraseñas. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Dónde está la Pokédex API
API_URL=http://127.0.0.1:8000
